DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

AI_BACKEND=openai
CODEX_BRIDGE_URL=http://host.docker.internal:8787/v1/chat
CODEX_BRIDGE_TOKEN=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini

SYSTEM_PROMPT=你是一个严谨、简洁的工作助手。使用用户的语言回答，不要声称完成了实际未执行的操作。
COMMAND_PREFIX=
ALLOWED_USERS=
MAX_INPUT_CHARS=6000
MAX_HISTORY_MESSAGES=12
REQUEST_TIMEOUT_SECONDS=120
DB_PATH=/app/data/bot.db
RUNTIME_CONFIG_PATH=/app/data/runtime.json
LOG_LEVEL=INFO
ADMIN_PASSWORD=12345
