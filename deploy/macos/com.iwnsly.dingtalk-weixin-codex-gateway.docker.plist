<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.iwnsly.dingtalk-weixin-codex-gateway.docker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__PROJECT_DIR__/scripts/start-docker-desktop-gateway.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/tmp/dingtalk-weixin-codex-gateway-docker.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/dingtalk-weixin-codex-gateway-docker.err</string>
</dict>
</plist>
